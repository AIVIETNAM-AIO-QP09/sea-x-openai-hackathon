{
  "name": "megaday-twin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "tsc --noEmit && cf build --mode cloudflare",
    "deploy:cloudflare": "cf deploy --prebuilt --mode cloudflare",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.64.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "cf": "1.0.0-beta.26",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
